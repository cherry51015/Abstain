# Copy to .env for local runs. Every variable is optional.
GROQ_API_KEY=                     # without it the service runs in rules-only mode
LLM_MODEL=qwen/qwen3.8-27b
LLM_EXTRA_BODY={}
LLM_SAMPLES=3                     # self-consistency samples per extraction
LLM_RPM=6                         # client-side pacing to stay under the provider quota
LLM_MAX_TOKENS=400
EXTRACTION_MODE=cascade           # rules | llm | cascade
DATABASE_URL=sqlite:///./abstain.db
ABSTAIN_API_KEY=                  # when set, write endpoints require X-API-Key
CORS_ORIGINS=http://localhost:5173,https://abstain-kappa.vercel.app
DEMO_SEED=                        # true on a hosted demo: loads 600 sample resolved disputes on first start
